# Railway PostgreSQL (set automatically by Railway plugin)
DATABASE_URL=postgresql://user:pass@host:5432/db

# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=deepseek/deepseek-r1
# Live mode: OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# Polymarket (required only for live mode)
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_PROXY_ADDRESS=0x...

# Trading
TRADING_MODE=paper
MAX_BET_USD=5.0
MIN_EDGE=0.08
PAPER_STARTING_BALANCE_USD=10000.0
KELLY_FRACTION=0.25
MAX_CONCURRENT_POSITIONS=10
MAX_DAILY_LLM_COST_USD=2.0

# Dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme_in_production

# Alerting (optional)
ALERT_WEBHOOK_URL=
SENTRY_DSN=

# App
PORT=8080
ENVIRONMENT=production
